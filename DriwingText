DrawImage()

 const img=new Image();
        img.onload=() =>{
            ctx.drawImage(img,0,0);
            ctx.beginPath();
            ctx.moveTo(30,96);
            ctx.lineTo(80, 66);
            ctx.lineTo(103,76);
            ctx.lineTo(170,15);
            ctx.stroke();
        };
img.src=”backdrop.png”;

